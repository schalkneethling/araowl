# AraOwl environment schema (varlock). Secret values live in the 1Password
# "dev" vault, items `araowl-cloudflare` (fields: account-id, ai-token) and
# `araowl-sentry` (field: auth-token).
#
# @envFlag=APP_ENV
# @defaultRequired=false @defaultSensitive=false
# @generateTypes(lang='ts', path='env.d.ts')
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, account=my.1password.com)
# ---

# @type=enum(dev, preview, production)
APP_ENV=dev

# 1Password service account token (CI/deploys only; local dev uses the desktop app)
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# NOTE: 1Password `op()` references live in the committed `.env.production`
# layer, not here. Varlock resolves every reference in the loaded graph and
# treats failure as fatal, so putting them in the base schema would make every
# build — dev server, Playwright webServer, the Docker VRT container — depend
# on 1Password access. Only APP_ENV=production builds load that layer.

# Cloudflare account ID, used by scripts/generate-quiz-index.ts (Phase 3 —
# nothing consumes it yet; restore @required when that script lands)
CF_ACCOUNT_ID=

# Cloudflare API token (Workers AI Read + Edit); build-time only — deployed
# Functions use the AI binding instead. Not @required until Phase 3 consumes it.
# @sensitive
CLOUDFLARE_AI_TOKEN=

# Sentry DSN for the browser project (org o4509032586870784, project araowl).
# Deliberately public: DSNs ship in the client bundle by design and only
# permit event submission, not data access.
SENTRY_DSN=https://84e098ee3a682c8a7fee134d3594f111@o4509032586870784.ingest.de.sentry.io/4511801472319568

# Sentry organization auth token for source-map upload at build time. Empty
# outside production builds, so the upload plugin is disabled for local dev,
# e2e, and the VRT container; deployed CI provides it directly as an env var.
# @sensitive
SENTRY_AUTH_TOKEN=

# Umami analytics (self-hosted, cookieless). Public config by design — the
# script URL and website id are visible in page source anyway; the script only
# loads after explicit user consent (see src/core/analytics.ts).
UMAMI_SCRIPT_URL=https://analytics.schalkneethling.com/analytics.js
UMAMI_WEBSITE_ID=8363bda8-c73c-4338-b878-407647ec82a5
