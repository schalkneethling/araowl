# AraOwl environment schema — managed by varlock (https://varlock.dev)
# Secret VALUES live in the 1Password "dev" vault (my.1password.com); nothing sensitive is committed.
# Local dev: 1Password desktop app + CLI integration (biometric unlock). CI/deploys: OP_TOKEN service account.
#
# Required 1Password item (create once in the "dev" vault):
#   Item name: araowl-cloudflare
#   Fields:    account-id (text), ai-token (concealed)
#
# @envFlag=APP_ENV
# @defaultRequired=false @defaultSensitive=false
# @generateTypes(lang='ts', path='env.d.ts')
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, account=my.1password.com)
# ---

# 1Password service account token — only needed in CI/deployed environments;
# local development authenticates through the 1Password desktop app instead
# App environment flag
# @type=enum(dev, preview, production)
APP_ENV=dev

# 1Password service account token — only needed in CI/deployed environments;
# local development authenticates through the 1Password desktop app instead
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# Cloudflare account ID — used by scripts/generate-quiz-index.ts for Workers AI REST calls
# @required
CF_ACCOUNT_ID=op(op://dev/araowl-cloudflare/account-id)

# Cloudflare API token scoped to Workers AI (read+run) — build-time generation only;
# the deployed Pages Function uses the AI binding and needs no token
# @required @sensitive
CLOUDFLARE_AI_TOKEN=op(op://dev/araowl-cloudflare/ai-token)
