# Production-only env layer (loaded when APP_ENV=production). Committed on
# purpose: these are 1Password *references*, not secret values — varlock
# resolves them at build time via the desktop app locally or a service
# account (OP_TOKEN) in CI. Real env vars with the same names take
# precedence, which is how Cloudflare-configured secrets override 1Password.
CF_ACCOUNT_ID=op(op://dev/araowl-cloudflare/account-id)
CLOUDFLARE_AI_TOKEN=op(op://dev/araowl-cloudflare/ai-token)
SENTRY_AUTH_TOKEN=op(op://dev/araowl-sentry/auth-token)
