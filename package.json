{
  "name": "araowl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix && stylelint --fix \"src/**/*.css\"",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config playwright.a11y.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/poppins": "^5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@playwright/test": "^1.61.1",
    "@schalkneethling/axe-aggregate-reporter": "^0.6.2",
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@varlock/1password-plugin": "^2.0.0",
    "@varlock/cloudflare-integration": "^1.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-use-baseline": "^1.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "varlock": "^1.11.0",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.112.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.0",
      "onFail": "download"
    }
  }
}
